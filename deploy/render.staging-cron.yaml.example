# ALTERNATIVE to the persistent worker, not an additional dispatch loop.
# Review-only; create/link a staging environment group manually with the same
# required NODE_ENV, APP_ENV=staging, all STAGING_* isolation pins, MongoDB,
# CLIENT_URL, JWT/OTP and sandbox SMTP settings as the API (Cloudinary optional).
# Provider scheduling, runtime limits and plan costs require operator approval.
services:
  - type: cron
    name: planzo-staging-email-batch
    runtime: node
    rootDir: server
    buildCommand: npm ci --omit=dev
    startCommand: npm run email:worker -- --once
    schedule: "*/5 * * * *"
    autoDeployTrigger: off
    envVars:
      - fromGroup: planzo-staging
      - key: NODE_VERSION
        value: "22"
      - key: APP_ENV
        value: staging
      - key: STAGING_EMAIL_MODE
        value: sandbox
