# Public build configuration only. Never put secrets in VITE_* variables.
# Production builds require an explicit HTTPS API URL; configure it per Vercel environment.
VITE_API_URL=http://localhost:5001/api
# Hosted staging builds: set APP_ENV=staging in the build environment and use an HTTPS staging API hostname.
# APP_ENV is a build guard, not a VITE_* browser variable.
