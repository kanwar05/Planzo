NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/planzo
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
CLIENT_URL=http://localhost:5173
# Number of trusted reverse-proxy hops; use 1 only behind a trusted single proxy.
TRUST_PROXY=0
# Production defaults to none with Secure cookies; use lax for same-site deployments.
COOKIE_SAME_SITE=lax

# Essential password-recovery and email-address-verification emails.
# SMTP_APP_PASSWORD is a Gmail App Password, not the normal Gmail password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Used by Gmail OTP delivery. SMTP_PASS remains supported for other SMTP relays.
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Planzo
SMTP_FROM_EMAIL=

# Email OTP sign-in. Use a separate random secret for OTP_HMAC_SECRET.
OTP_HMAC_SECRET=
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional for marketplace browsing; all three required to enable vendor photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional abuse limits. Defaults shown.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_REQUEST_MAX=3
PASSWORD_RESET_ATTEMPT_MAX=10

# One-time administrator provisioning: npm run admin:create.
# Never commit a real password; remove it after use.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
