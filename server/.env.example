NODE_ENV=development
# Set APP_ENV=staging for the strict isolation checks below; NODE_ENV remains production on hosted staging.
APP_ENV=development
PORT=5001
# Booking/availability transactions require an initialized replica set (Atlas works).
MONGODB_URI=mongodb://127.0.0.1:27017/planzo?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Optional browser cookie lifetimes (milliseconds); server token expiry still applies.
# ACCESS_COOKIE_MAX_AGE_MS=900000
# REFRESH_COOKIE_MAX_AGE_MS=2592000000
CLIENT_URL=http://localhost:5173
# Booking email links use the first CLIENT_URL origin, as account email links do.
# Number of trusted reverse-proxy hops; use 1 only behind a trusted single proxy.
TRUST_PROXY=0
# Production defaults to none with Secure cookies; use lax for same-site deployments.
COOKIE_SAME_SITE=lax

# Essential password-recovery and email-address-verification emails.
# Booking email notifications reuse this SMTP configuration in a separate process:
# cd server; npm run email:worker (or npm run email:worker -- --once).
# SMTP_APP_PASSWORD is a Gmail App Password, not the normal Gmail password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Used by Gmail OTP delivery. SMTP_PASS remains supported for other SMTP relays.
SMTP_APP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Planzo
SMTP_FROM_EMAIL=

# Email OTP sign-in. Use a separate random secret for OTP_HMAC_SECRET.
OTP_HMAC_SECRET=
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional for marketplace browsing; all three required to enable vendor photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional abuse limits. Defaults shown.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_REQUEST_MAX=3
PASSWORD_RESET_ATTEMPT_MAX=10

# Bounded database waits; all four accept integer milliseconds from 1000 to 120000.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
# Emit a sanitized slow-request event at this duration (100 to 60000 ms).
SLOW_REQUEST_MS=1000

# One-time administrator provisioning: npm run admin:create.
# Never commit a real password; remove it after use.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Opt-in hosted staging only. Leave the pins empty outside staging.
# Use a dedicated Atlas project/cluster and a least-privilege staging DB user.
# The URI must name this exact database (with a staging name), and this exact hostname.
STAGING_MONGO_HOST=
STAGING_DATABASE_NAME=
# Must equal the only CLIENT_URL origin and contain a staging hostname.
STAGING_FRONTEND_ORIGIN=
# Use a sandbox SMTP sink, not a production delivery relay.
STAGING_SMTP_HOST=
STAGING_EMAIL_MODE=
# Comma-separated exact authorized test addresses, at most 10; no wildcards.
STAGING_EMAIL_RECIPIENTS=
# Required when staging image uploads are configured; use a separate Cloudinary product environment.
# Staging public IDs also use eventifyy/staging/ and cannot delete IDs outside that prefix.
STAGING_CLOUDINARY_CLOUD_NAME=
